{
  "schemaVersion": 1,
  "id": "ericvrp.sleep-actions",
  "name": "Sleep Actions",
  "version": "0.3.2",
  "author": "Eric van Riet Paap (fork of hungmi.battery-session by hungmi)",
  "license": "MIT",
  "description": "Battery session measurement plus controls for what to shut down before suspend (Bluetooth, Wi-Fi), with the active settings recorded in every sample.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Sleep Actions",
    "description": "Battery session stats and sleep-time radio controls.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "barLabel": "remainHist",
      "lang": "auto"
    },
    "schema": [
      {
        "key": "barLabel",
        "type": "enum",
        "label": "Bar shows",
        "options": [
          "remainHist",
          "remainCur",
          "awake"
        ],
        "defaultValue": "remainHist"
      },
      {
        "key": "lang",
        "type": "enum",
        "label": "Language",
        "options": [
          "auto",
          "en",
          "zh-Hant",
          "zh-Hans"
        ],
        "defaultValue": "auto"
      }
    ]
  }
}
